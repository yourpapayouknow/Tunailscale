+// setIOSRoute updates one kernel route without relying on the absent iOS route binary.
+func (r *userspaceBSDRouter) setIOSRoute(prefix netip.Prefix, messageType int) error {
+	ifc, err := net.InterfaceByName(r.tunname)
+	if err != nil {
+		return fmt.Errorf("looking up interface %q: %w", r.tunname, err)
+	}
+
+	prefix = prefix.Masked()
+	var dst, mask route.Addr
+	if prefix.Addr().Is4() {
+		dst = &route.Inet4Addr{IP: prefix.Addr().As4()}
+		var mask4 [4]byte
+		copy(mask4[:], net.CIDRMask(prefix.Bits(), 32))
+		mask = &route.Inet4Addr{IP: mask4}
+	} else {
+		dst = &route.Inet6Addr{IP: prefix.Addr().As16()}
+		var mask6 [16]byte
+		copy(mask6[:], net.CIDRMask(prefix.Bits(), 128))
+		mask = &route.Inet6Addr{IP: mask6}
+	}
+
+	fd, err := unix.Socket(unix.AF_ROUTE, unix.SOCK_RAW, unix.AF_UNSPEC)
+	if err != nil {
+		return fmt.Errorf("creating route socket: %w", err)
+	}
+	defer unix.Close(fd)
+
+	msg := route.RouteMessage{
+		Version: 0x5,
+		Type:    messageType,
+		Flags:   unix.RTF_UP | unix.RTF_STATIC,
+		ID:      uintptr(os.Getpid()),
+		Seq:     1,
+		Addrs: []route.Addr{
+			unix.RTAX_DST:     dst,
+			unix.RTAX_GATEWAY: &route.LinkAddr{Index: ifc.Index},
+			unix.RTAX_NETMASK: mask,
+		},
+	}
+	b, err := msg.Marshal()
+	if err != nil {
+		return fmt.Errorf("marshaling route message: %w", err)
+	}
+	_, err = unix.Write(fd, b)
+	if (messageType == unix.RTM_ADD && errors.Is(err, unix.EEXIST)) ||
+		(messageType == unix.RTM_DELETE && errors.Is(err, unix.ESRCH)) {
+		return nil
+	}
+	return err
+}
