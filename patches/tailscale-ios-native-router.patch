+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build ios && cgo
+
+package osrouter
+
+/*
+#include <arpa/inet.h>
+#include <errno.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+// Apple XNU bsd/netinet6/in6_var.h defines the IPv6 ioctl ABI omitted by the iOS SDK.
+// https://github.com/apple-oss-distributions/xnu/blob/main/bsd/netinet6/in6_var.h
+struct ts_in6_lifetime {
+	time_t expire;
+	time_t preferred;
+	uint32_t valid;
+	uint32_t preferred_lifetime;
+};
+
+struct ts_in6_aliasreq {
+	char name[IFNAMSIZ];
+	struct sockaddr_in6 addr;
+	struct sockaddr_in6 dst;
+	struct sockaddr_in6 mask;
+	int flags;
+	struct ts_in6_lifetime lifetime;
+};
+
+struct ts_in6_ifreq {
+	char name[IFNAMSIZ];
+	union {
+		struct sockaddr_in6 addr;
+		uint64_t reserved[34];
+	} value;
+};
+
+_Static_assert(sizeof(struct ts_in6_aliasreq) == 128, "unexpected Darwin in6_aliasreq size");
+_Static_assert(sizeof(struct ts_in6_ifreq) == 288, "unexpected Darwin in6_ifreq size");
+
+#define TS_SIOCAIFADDR_IN6 _IOW('i', 26, struct ts_in6_aliasreq)
+#define TS_SIOCDIFADDR_IN6 _IOW('i', 25, struct ts_in6_ifreq)
+
+// ts_name validates and copies an interface name.
+static int ts_name(char *dst, const char *src) {
+	if (strlcpy(dst, src, IFNAMSIZ) >= IFNAMSIZ) {
+		return ENAMETOOLONG;
+	}
+	return 0;
+}
+
+// ts_done closes an ioctl socket without losing its error.
+static int ts_done(int fd, int err) {
+	close(fd);
+	return err;
+}
+
+// ts_if_up marks an interface administratively up.
+static int ts_if_up(const char *name) {
+	int fd = socket(AF_INET, SOCK_DGRAM, 0);
+	if (fd < 0) {
+		return errno;
+	}
+
+	struct ifreq req;
+	memset(&req, 0, sizeof(req));
+	int err = ts_name(req.ifr_name, name);
+	if (err != 0) {
+		return ts_done(fd, err);
+	}
+	if (ioctl(fd, SIOCGIFFLAGS, &req) < 0) {
+		return ts_done(fd, errno);
+	}
+	req.ifr_flags |= IFF_UP;
+	if (ioctl(fd, SIOCSIFFLAGS, &req) < 0) {
+		return ts_done(fd, errno);
+	}
+	return ts_done(fd, 0);
+}
+
+// ts_mask4 fills an IPv4 prefix mask.
+static void ts_mask4(struct sockaddr_in *mask, int bits) {
+	mask->sin_len = sizeof(*mask);
+	mask->sin_family = AF_INET;
+	mask->sin_addr.s_addr = bits == 0 ? 0 : htonl(UINT32_MAX << (32 - bits));
+}
+
+// ts_mask6 fills an IPv6 prefix mask.
+static void ts_mask6(struct sockaddr_in6 *mask, int bits) {
+	mask->sin6_len = sizeof(*mask);
+	mask->sin6_family = AF_INET6;
+	for (int i = 0; i < 16 && bits > 0; i++) {
+		if (bits >= 8) {
+			mask->sin6_addr.s6_addr[i] = 0xff;
+			bits -= 8;
+		} else {
+			mask->sin6_addr.s6_addr[i] = (uint8_t)(0xff << (8 - bits));
+			bits = 0;
+		}
+	}
+}
+
+// ts_addr updates one address using the matching native ioctl family.
+static int ts_addr(const char *name, const char *address, int bits, int ipv6, int remove) {
+	if (bits < 0 || bits > (ipv6 ? 128 : 32)) {
+		return EINVAL;
+	}
+	int family = ipv6 ? AF_INET6 : AF_INET;
+	int fd = socket(family, SOCK_DGRAM, 0);
+	if (fd < 0) {
+		return errno;
+	}
+
+	union {
+		struct ifaliasreq v4;
+		struct ts_in6_aliasreq v6;
+		struct ts_in6_ifreq del6;
+	} req;
+	memset(&req, 0, sizeof(req));
+	int err = ts_name(req.v4.ifra_name, name);
+	if (err != 0) {
+		return ts_done(fd, err);
+	}
+	unsigned long op;
+	if (ipv6) {
+		req.v6.addr.sin6_len = sizeof(req.v6.addr);
+		req.v6.addr.sin6_family = family;
+		if (inet_pton(family, address, &req.v6.addr.sin6_addr) != 1) {
+			return ts_done(fd, EINVAL);
+		}
+		memcpy(&req.v6.dst, &req.v6.addr, sizeof(req.v6.addr));
+		ts_mask6(&req.v6.mask, bits);
+		req.v6.lifetime.valid = UINT32_MAX;
+		req.v6.lifetime.preferred_lifetime = UINT32_MAX;
+		op = remove ? TS_SIOCDIFADDR_IN6 : TS_SIOCAIFADDR_IN6;
+	} else {
+		struct sockaddr_in *addr = (struct sockaddr_in *)&req.v4.ifra_addr;
+		addr->sin_len = sizeof(*addr);
+		addr->sin_family = family;
+		if (inet_pton(family, address, &addr->sin_addr) != 1) {
+			return ts_done(fd, EINVAL);
+		}
+		memcpy(&req.v4.ifra_broadaddr, addr, sizeof(*addr));
+		ts_mask4((struct sockaddr_in *)&req.v4.ifra_mask, bits);
+		op = remove ? SIOCDIFADDR : SIOCAIFADDR;
+	}
+	if (ioctl(fd, op, &req) < 0) {
+		err = errno;
+		if ((remove && err == EADDRNOTAVAIL) || (!remove && err == EEXIST)) {
+			err = 0;
+		}
+	}
+	return ts_done(fd, err);
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"net/netip"
+	"syscall"
+	"unsafe"
+)
+
+// iosIfUp brings an iOS interface online without spawning ifconfig.
+func iosIfUp(name string) error {
+	cname := C.CString(name)
+	defer C.free(unsafe.Pointer(cname))
+	if errno := C.ts_if_up(cname); errno != 0 {
+		return fmt.Errorf("bringing interface %q up: %w", name, syscall.Errno(errno))
+	}
+	return nil
+}
+
+// iosSetAddr updates one iOS interface address without spawning ifconfig.
+func iosSetAddr(name string, prefix netip.Prefix, remove bool) error {
+	cname := C.CString(name)
+	defer C.free(unsafe.Pointer(cname))
+	caddr := C.CString(prefix.Addr().String())
+	defer C.free(unsafe.Pointer(caddr))
+
+	ipv6 := 0
+	if prefix.Addr().Is6() {
+		ipv6 = 1
+	}
+	del := 0
+	if remove {
+		del = 1
+	}
+	if errno := C.ts_addr(cname, caddr, C.int(prefix.Bits()), C.int(ipv6), C.int(del)); errno != 0 {
+		return fmt.Errorf("updating interface %q address %v: %w", name, prefix, syscall.Errno(errno))
+	}
+	return nil
+}
