+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build (darwin || freebsd) && (!ios || !cgo)
+
+package osrouter
+
+import "net/netip"
+
+// iosIfUp rejects an unreachable non-iOS call.
+func iosIfUp(string) error {
+	panic("iosIfUp called outside an iOS cgo build")
+}
+
+// iosSetAddr rejects an unreachable non-iOS call.
+func iosSetAddr(string, netip.Prefix, bool) error {
+	panic("iosSetAddr called outside an iOS cgo build")
+}
